APP_NAME=Enterprise Search AI
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
DEBUG=false
API_PREFIX=/api/v1
# Set a private random service key of at least 16 characters.
INTERNAL_API_KEY=
AI_DEVICE=auto
AI_ALLOW_DEVICE_FALLBACK=true
AI_LAZY_MODEL_LOADING=true
AI_REQUIRED_MODELS=[]
AI_MODEL_CACHE_DIR=model-cache
AI_OFFLINE=true
TEXT_EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
TEXT_EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
TEXT_EMBEDDING_DEVICE=auto
TEXT_EMBEDDING_BATCH_SIZE=16
TEXT_EMBEDDING_NORMALIZE=true
COLPALI_MODEL_ID=vidore/colpali-v1.3-merged
COLPALI_REVISION=c24894ff88e82f6e11d92e89a62572d324969bbc
COLPALI_DEVICE=auto
COLPALI_PRECISION=fp32
COLPALI_MAX_QUERY_TOKENS=512
COLPALI_BATCH_SIZE=1
AI_MAX_CONCURRENT_INFERENCES=1
AI_INFERENCE_TIMEOUT_SECONDS=300
MAX_REQUEST_BYTES=2000000
MAX_UPLOAD_BYTES=50000000
MAX_PAGES=200
MAX_IMAGE_PIXELS=25000000
MAX_IMAGE_SIDE=2400
SUPPORTED_MIME_TYPES=["application/pdf", "image/jpeg", "image/png"]
RENDER_DPI=150
RENDER_FORMAT=PNG
OCR_LANGUAGES=eng
OCR_DESKEW=true
OCR_PSM=6
OCR_MIN_CONFIDENCE=55
OCR_TIMEOUT_SECONDS=45
NATIVE_MIN_CHARS=20
CHUNK_STRATEGY=heading
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
STORAGE_BACKEND=local
STORAGE_ROOT=objects
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
STORAGE_TIMEOUT=15
PRESIGN_SECONDS=300
LLM_PROVIDER=disabled
# LLM_ENDPOINT=
# LLM_API_KEY=
# LLM_MODEL=
LLM_RESPONSE_FORMAT=json_schema
LLM_TIMEOUT=30
LLM_RETRIES=2
